<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Swiss Weather Stations — <%= data[:title] %></title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
<style>
  :root {
    --bg: #0f1419; --panel: #1a2027; --ink: #e6edf3; --muted: #9aa7b4;
    --accent: #58a6ff; --border: #2b333c;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; height: 100%; font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  body { background: var(--bg); color: var(--ink); display: flex; flex-direction: column; }

  header {
    padding: 12px 18px; background: var(--panel); border-bottom: 1px solid var(--border);
    display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap;
  }
  header h1 { font-size: 17px; margin: 0; font-weight: 650; }
  nav { display: inline-flex; gap: 6px; margin-left: 4px; }
  nav a {
    font-size: 12px; padding: 4px 10px; border-radius: 7px; text-decoration: none;
    color: var(--muted); border: 1px solid var(--border);
  }
  nav a.active { background: var(--accent); color: #06121f; border-color: var(--accent); font-weight: 650; }
  header .meta { color: var(--muted); font-size: 12px; }

  #map { flex: 1 1 auto; min-height: 0; background: #0b0e12; }

  .controls {
    background: var(--panel); border-top: 1px solid var(--border);
    padding: 12px 18px; display: flex; align-items: center; gap: 18px; flex-wrap: wrap;
  }
  .controls .group { display: flex; align-items: center; gap: 8px; }
  .controls label { font-size: 13px; color: var(--muted); }
  .date-readout { font-variant-numeric: tabular-nums; font-size: 15px; font-weight: 650; min-width: 132px; }
  input[type=range] { width: min(46vw, 520px); accent-color: var(--accent); }
  button {
    background: #222b34; color: var(--ink); border: 1px solid var(--border);
    border-radius: 7px; padding: 6px 12px; font-size: 13px; cursor: pointer;
  }
  button:hover { border-color: var(--accent); }
  button.active { background: var(--accent); color: #06121f; border-color: var(--accent); font-weight: 650; }
  .seg { display: inline-flex; border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
  .seg button { border: none; border-radius: 0; border-right: 1px solid var(--border); }
  .seg button:last-child { border-right: none; }
  .stat { font-size: 12px; color: var(--muted); }
  .stat b { color: var(--ink); font-variant-numeric: tabular-nums; }

  .temp-label {
    font-size: 11px; font-weight: 700; color: #fff; text-shadow: 0 1px 2px rgba(0,0,0,.85);
    pointer-events: none; white-space: nowrap; font-variant-numeric: tabular-nums;
  }

  .legend {
    background: rgba(26,32,39,.92); color: var(--ink); padding: 8px 10px; border-radius: 8px;
    border: 1px solid var(--border); font-size: 11px; line-height: 1.5;
  }
  .legend .bar { height: 10px; border-radius: 3px; margin-bottom: 4px;
    background: linear-gradient(to right,
      #313695,#4575b4,#abd9e9,#e0f3f8,#ffffbf,#fee090,#fdae61,#f46d43,#d73027,#a50026); }
  .legend .ticks { display: flex; justify-content: space-between; color: var(--muted); }
  a { color: var(--accent); }
</style>
</head>
<body>
<header>
  <h1>🇨🇭 Swiss Weather Stations</h1>
  <nav>
    <a href="index.html"<%= ' class="active"' if data[:axis] == 'date' %>>Daily</a>
    <a href="annual.html"<%= ' class="active"' if data[:axis] == 'year' %>>Annual</a>
  </nav>
  <span class="meta">
    <%= data[:subtitle] %> ·
    <span id="station-count"></span> stations ·
    <a href="https://opendatadocs.meteoswiss.ch" target="_blank" rel="noopener">MeteoSwiss Open Data</a>
  </span>
</header>

<div id="map"></div>

<div class="controls">
  <div class="group">
    <button id="play" title="Play / pause">▶</button>
  </div>
  <div class="group">
    <span class="date-readout" id="date-readout">—</span>
    <input type="range" id="slider" min="0" value="0" step="1">
  </div>
  <div class="group">
    <label><%= data[:metric_note] %></label>
    <div class="seg" id="metric">
      <button data-metric="max" class="active">Max °C</button>
      <button data-metric="min">Min °C</button>
    </div>
  </div>
  <div class="group">
    <label><input type="checkbox" id="show-values" checked> values</label>
  </div>
  <div class="group stat" id="stats"></div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
const DATA = <%= data_json %>;
const AXIS = DATA.axis; // "date" | "year"

// ---- Color scale (RdYlBu reversed): temperature °C -> rgb ----------------
const STOPS = [
  [-20, [49,54,149]],  [-10, [69,117,180]], [-5, [116,173,209]],
  [0,   [171,217,233]],[5,   [224,243,248]],[10, [255,255,191]],
  [15,  [254,224,144]],[20,  [253,174,97]], [25, [244,109,67]],
  [30,  [215,48,39]],  [38,  [165,0,38]]
];
const rgb = a => `rgb(${a[0]},${a[1]},${a[2]})`;
function tempColor(t) {
  if (t == null || Number.isNaN(t)) return '#5b6570';
  if (t <= STOPS[0][0]) return rgb(STOPS[0][1]);
  if (t >= STOPS[STOPS.length-1][0]) return rgb(STOPS[STOPS.length-1][1]);
  for (let i = 0; i < STOPS.length-1; i++) {
    const [t0,c0] = STOPS[i], [t1,c1] = STOPS[i+1];
    if (t >= t0 && t <= t1) {
      const f = (t-t0)/(t1-t0);
      return rgb([0,1,2].map(k => Math.round(c0[k] + f*(c1[k]-c0[k]))));
    }
  }
  return '#5b6570';
}

// ---- Map -----------------------------------------------------------------
const map = L.map('map', { minZoom: 7, maxZoom: 12, zoomControl: true })
  .setView([46.8, 8.23], 8);
map.setMaxBounds([[45.5, 5.5], [48.0, 11.0]]);
L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
  attribution: '&copy; OpenStreetMap &copy; CARTO', subdomains: 'abcd', maxZoom: 12
}).addTo(map);

// ---- State ---------------------------------------------------------------
let metric = 'max';
let idx = DATA.labels.length - 1;   // start at most recent label
let playing = false, timer = null, showValues = true;
document.getElementById('station-count').textContent = DATA.stations.length;

const markers = DATA.stations.map(st => {
  const m = L.circleMarker([st.lat, st.lon], {
    radius: 8, weight: 1.2, color: '#11161c', fillOpacity: 0.95
  }).addTo(map);
  m.bindTooltip('', { permanent: true, direction: 'right', offset: [6,0],
                      className: 'temp-label', opacity: 1 });
  m.bindPopup('');
  return { st, m };
});

function fmtLabel(label) {
  if (AXIS === 'year') return label;
  const [y,m,d] = label.split('-');
  return new Date(Date.UTC(+y, +m-1, +d))
    .toLocaleDateString('en-GB', { weekday:'short', day:'2-digit', month:'short', year:'numeric', timeZone:'UTC' });
}
const fmtVal = v => (v == null ? '–' : v.toFixed(1));

function render() {
  const label = DATA.labels[idx];
  document.getElementById('date-readout').textContent = fmtLabel(label);
  document.getElementById('slider').value = idx;

  let lo = Infinity, hi = -Infinity, sum = 0, n = 0;
  for (const { st, m } of markers) {
    const v = st[metric][idx];
    if (v == null) {
      m.setStyle({ fillColor: '#39424c', fillOpacity: 0.25, radius: 5 });
      m.setTooltipContent(''); m.getTooltip()?.setOpacity(0);
      m.setPopupContent(`<b>${st.name}</b> (${st.canton}) · ${st.alt} m<br>no data ${fmtLabel(label)}`);
      continue;
    }
    m.setStyle({ fillColor: tempColor(v), fillOpacity: 0.95, radius: 7 + Math.min(6, Math.abs(v)/6) });
    m.setTooltipContent(showValues ? `${v.toFixed(1)}` : '');
    m.getTooltip()?.setOpacity(showValues ? 1 : 0);
    m.setPopupContent(
      `<b>${st.name}</b> (${st.canton}) · ${st.alt} m a.s.l.<br>${fmtLabel(label)}<br>` +
      `max <b>${fmtVal(st.max[idx])} °C</b> · min <b>${fmtVal(st.min[idx])} °C</b>`);
    lo = Math.min(lo, v); hi = Math.max(hi, v); sum += v; n++;
  }

  document.getElementById('stats').innerHTML = n
    ? `coldest <b>${lo.toFixed(1)}°</b> · warmest <b>${hi.toFixed(1)}°</b> · ` +
      `mean <b>${(sum/n).toFixed(1)}°</b> · <b>${n}</b> reporting`
    : 'no data';
}

// ---- Controls ------------------------------------------------------------
const slider = document.getElementById('slider');
slider.max = DATA.labels.length - 1;
slider.value = idx;
slider.addEventListener('input', e => { idx = +e.target.value; render(); });

document.querySelectorAll('#metric button').forEach(btn => {
  btn.addEventListener('click', () => {
    metric = btn.dataset.metric;
    document.querySelectorAll('#metric button').forEach(b => b.classList.toggle('active', b === btn));
    render();
  });
});

document.getElementById('show-values').addEventListener('change', e => { showValues = e.target.checked; render(); });

const playBtn = document.getElementById('play');
playBtn.addEventListener('click', () => {
  playing = !playing;
  playBtn.textContent = playing ? '⏸' : '▶';
  playBtn.classList.toggle('active', playing);
  if (playing) {
    timer = setInterval(() => { idx = (idx + 1) % DATA.labels.length; render(); }, AXIS === 'year' ? 600 : 350);
  } else { clearInterval(timer); }
});

document.addEventListener('keydown', e => {
  if (e.key === 'ArrowLeft')  { idx = Math.max(0, idx-1); render(); }
  if (e.key === 'ArrowRight') { idx = Math.min(DATA.labels.length-1, idx+1); render(); }
});

// ---- Legend --------------------------------------------------------------
const legend = L.control({ position: 'bottomright' });
legend.onAdd = () => {
  const div = L.DomUtil.create('div', 'legend');
  div.innerHTML =
    '<div>Air temperature (°C)</div><div class="bar"></div>' +
    '<div class="ticks"><span>-20</span><span>0</span><span>15</span><span>30</span><span>38</span></div>';
  return div;
};
legend.addTo(map);

render();
</script>
</body>
</html>
